# Arquivos que o git deve ignorar

# Ambiente virtual e cache do Python
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/

# Datasets temporários usados só para testar o pipeline (ex.: dataset sintético)
dataset_teste/
dataset_sintetico/

# Arquivos do sistema e de editores
.DS_Store
Thumbs.db
.vscode/
.idea/
.ipynb_checkpoints/

# Dependências do Node (instaladas com npm install)
node_modules/

# Fotos dos integrantes: são dados pessoais e ficam só na máquina de quem coletou
dataset/*
!dataset/.gitkeep

# Gerados pelo treino (python -m src.treinar): o modelo e as imagens mostram os rostos do grupo
modelo/*
!modelo/.gitkeep
web/img/resultados/*
!web/img/resultados/.gitkeep
